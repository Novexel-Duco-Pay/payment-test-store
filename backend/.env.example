# Secret key from the Duco dashboard (duco_test_... or duco_live_...). Never commit the real value.
# DOCU_PAY_API is accepted as an alias of this variable.
DUCO_MERCHANT_KEY=

# Signing secret shown once when the webhook endpoint is registered (whsec_...).
DUCO_WEBHOOK_SECRET=

# Test keys use the staging API. Override this if Duco gives you a different host.
DUCO_API_BASE=https://api-staging.ducopay.com

# Storefront origin. Duco redirects the customer here after checkout.
# Separate extra origins with commas, for example the Render site and localhost.
APP_ORIGIN=http://localhost:5173

# Render sets PORT. Locally this falls back to API_PORT, then 3001.
API_PORT=3001
